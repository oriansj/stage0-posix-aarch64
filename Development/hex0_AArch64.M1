DEFINE ADD_W3_W3_10              63280011
DEFINE ADD_X1_SP_1               e1070091

DEFINE B_EQ_READ                 80feff54
DEFINE B_HS_READ                 a2fdff54
DEFINE B_LO_DIGIT                c3000054

DEFINE CBNZ_W11_READ             0bffff35

DEFINE CBZ_X0_EXIT               200300b4

DEFINE CCMP_W3_24_4_NE           6418587a

DEFINE CMP_W0_TO_10              1f280071
DEFINE CMP_W3_TO_10              7f280071
DEFINE CMP_W3_TO_6               7f180071

DEFINE CSEL_W11_WZR_W11_EQ       eb038b1a

DEFINE CSET_W11_EQ               eb179f1a

DEFINE LDRB_W0_[SP]              e0034039

DEFINE LDR_X1_[SP,16] e10b40f9
DEFINE LDR_X1_[SP,24] e10f40f9

DEFINE ORR_W12_W3_W12_LSL_4      6c100c2a
DEFINE ORR_W3_W0_32              03001b32

DEFINE RBRANCH 17

DEFINE SET_W11_TO_0              0b008052
DEFINE SET_W12_TO_1              2c008052
DEFINE SET_X0_FROM_X10 e0030aaa
DEFINE SET_X0_FROM_X9 e00309aa
DEFINE SET_X0_TO_FCNTL_H_AT_FDCWD 600c8092
DEFINE SET_X10_FROM_X0 ea0300aa
DEFINE SET_X1_FROM_SP            e1030091
DEFINE SET_X2_TO_0 020080d2
DEFINE SET_X2_TO_1 220080d2
DEFINE SET_X2_TO_577 224880d2
DEFINE SET_X3_TO_448 033880d2
DEFINE SET_X8_TO_SYS_EXIT a80b80d2
DEFINE SET_X8_TO_SYS_OPENAT 080780d2
DEFINE SET_X8_TO_SYS_READ e80780d2
DEFINE SET_X8_TO_SYS_WRITE 080880d2
DEFINE SET_X9_FROM_X0 e90300aa

DEFINE STRB_W12_[SP,1]           ec070039

DEFINE STR_XZR_[SP,MINUS_16]!    ff0f1ff8

DEFINE SUBS_W3_W0_35             038c0071

DEFINE SUB_W3_W0_48              03c00051
DEFINE SUB_W3_W3_97              63840151

DEFINE SYSCALL 010000d4

DEFINE TBZ_W12_8_READ            4cfd4736

:_start
    LDR_X1_[SP,16]              # Get the actual input name
    SET_X0_TO_FCNTL_H_AT_FDCWD  # AT_FDCWD, relative to current working directory
    SET_X2_TO_0                 # Prepare file as read only
    SET_X8_TO_SYS_OPENAT        # The syscall number for openat(), aarch64 has no open()
    SYSCALL                     # Open file!
    SET_X9_FROM_X0              # Preserve the file pointer we were given

    LDR_X1_[SP,24]              # Get the output name
    SET_X0_TO_FCNTL_H_AT_FDCWD  # AT_FDCWD, relative to current working directory
    SET_X2_TO_577               # Prepare file as O_WRONLY|O_CREAT|O_TRUNC
    SET_X3_TO_448               # Prepare file as RWX for owner only (700 in octal)
    SYSCALL                     # Open file!
    SET_X10_FROM_X0             # Preserve the file pointer we were given

    STR_XZR_[SP,MINUS_16]!      # Separate input and output bytes on the stack
    SET_X2_TO_1                 # set the size of chars we want
    SET_W11_TO_0                # Not in a comment

:pair
    SET_W12_TO_1                # Start the marker below the first hex digit

:read
    # Attempt to read 1 byte from input file
    SET_X0_FROM_X9              # Where are we reading from
    SET_X1_FROM_SP              # Where to put it
    SET_X8_TO_SYS_READ          # the syscall number for read
    SYSCALL                     # call the Kernel
    CBZ_X0_EXIT                 # Got EOF call it done
    LDRB_W0_[SP]                # load char, unsigned so zero-extended already
    CMP_W0_TO_10
    CSEL_W11_WZR_W11_EQ         # A newline ends the comment
    CBNZ_W11_READ               # Ignore the rest of the comment
    SUBS_W3_W0_35               # Purge Comment Lines (#)
    CCMP_W3_24_4_NE             # Purge Comment Lines (;)
    CSET_W11_EQ                 # Remember whether a comment starts here
    B_EQ_READ
    SUB_W3_W0_48                # Subtract ASCII '0'
    CMP_W3_TO_10
    B_LO_DIGIT                  # deal with 0-9
    ORR_W3_W0_32                # Fold upper case to lower case
    SUB_W3_W3_97
    CMP_W3_TO_6
    B_HS_READ                   # Ignore bytes outside a through f
    ADD_W3_W3_10

:digit
    ORR_W12_W3_W12_LSL_4        # Shift the marker and append the digit
    TBZ_W12_8_READ              # Until the marker reaches bit 8, read another digit
    STRB_W12_[SP,1]             # Only the low byte is output
    ADD_X1_SP_1                 # What we are writing
    SET_X0_FROM_X10             # Where are we writing to
    SET_X8_TO_SYS_WRITE         # the syscall number for write
    SYSCALL                     # call the Kernel
    ^~pair RBRANCH

:exit
    # program completed Successfully
    SET_X8_TO_SYS_EXIT          # put the exit syscall number in x8
    SYSCALL

:ELF_end
:ELF_sym
:ELF_str
