DEFINE ADD_X0_X0_X21             0000158b
DEFINE ADD_X1_SP_128             e1030291
DEFINE ADD_X1_X1_1   21040091
DEFINE ADD_X20_SP_24             f4630091
DEFINE ADD_X20_SP_32             f4830091

DEFINE ADR_X1_DEFAULT_FILE       e10f0010
DEFINE ADR_X1_HARD               81040050
DEFINE ADR_X1_NEWLINE            e1070010
DEFINE ADR_X1_PREFIX             c1080030
DEFINE ADR_X1_SPACE              41080050

DEFINE B_EQ_COMMAND              40faff54
DEFINE B_EQ_COMMENT              20020054
DEFINE B_EQ_DONE                 40090054
DEFINE B_EQ_ESCAPED              40010054
DEFINE B_EQ_EXIT                 60070054
DEFINE B_EQ_EXIT_FROM_COMMENT    e0050054
DEFINE B_EQ_LINE_END             a0030054
DEFINE B_EQ_QUOTED               e0000054
DEFINE B_EQ_RUN                  40000054
DEFINE B_EQ_WORD                 60fcff54
DEFINE B_EQ_WORD_END             20020054
DEFINE B_EQ_WORD_END_FROM_QUOTED 80000054
DEFINE B_LE_EXIT                 ad0b0054
DEFINE B_LT_EXIT                 6b020054
DEFINE B_NE_COMMENT              81ffff54
DEFINE B_NE_PARENT               e1000054
DEFINE B_NE_PRINT_ARG            61ffff54

DEFINE CBNZ_X1_OPEN_SCRIPT       610000b5

DEFINE CBZ_W0_FILE_PRINT_DONE    a0000034
DEFINE CBZ_X0_COMMAND            c0f5ffb4
DEFINE CBZ_X0_EXIT               600300b4
DEFINE CBZ_X1_FILE_PRINT_DONE    210100b4

DEFINE CCMP_W0_9_4_NE            0418497a

DEFINE CMP_W0_TO_10              1f280071
DEFINE CMP_W0_TO_252             1ff00371
DEFINE CMP_W0_TO_32              1f800071
DEFINE CMP_W0_TO_34              1f880071
DEFINE CMP_W0_TO_35              1f8c0071
DEFINE CMP_W0_TO_92              1f700171
DEFINE CMP_X0_TO_0   1f0000f1
DEFINE CMP_X22_TO_X23            df0217eb
DEFINE CMP_X24_TO_X25            1f0319eb
DEFINE CMP_X26_TO_X23            5f0317eb

DEFINE FBRANCH 14

DEFINE FCALL 94

DEFINE LDR_BYTE_W0_[X1]      20004039
DEFINE LDR_X0_[SP,24]            e00f40f9
DEFINE LDR_X0_[X22]              c00240f9
DEFINE LDR_X1_[SP,16] e10b40f9
DEFINE LDR_X1_[X26]_POST_8       418740f8

DEFINE RBRANCH 17

DEFINE RETURN c0035fd6

DEFINE SET_W9_TO_252             891f8052
DEFINE SET_X0_FROM_X19           e00313aa
DEFINE SET_X0_FROM_X9            e00309aa
DEFINE SET_X0_TO_0 000080d2
DEFINE SET_X0_TO_1 200080d2
DEFINE SET_X0_TO_17 200280d2
DEFINE SET_X0_TO_2048            000081d2
DEFINE SET_X0_TO_4096            000082d2
DEFINE SET_X0_TO_FCNTL_H_AT_FDCWD 600c8092
DEFINE SET_X19_FROM_X0           f30300aa
DEFINE SET_X1_FROM_X0 e10300aa
DEFINE SET_X1_FROM_X22           e10316aa
DEFINE SET_X1_TO_0 010080d2
DEFINE SET_X21_FROM_X0           f50300aa
DEFINE SET_X22_FROM_X0           f60300aa
DEFINE SET_X23_FROM_X0           f70300aa
DEFINE SET_X24_FROM_X0           f80300aa
DEFINE SET_X25_FROM_X0           f90300aa
DEFINE SET_X26_FROM_X22          fa0316aa
DEFINE SET_X2_FROM_SP            e2030091
DEFINE SET_X2_FROM_X20           e20314aa
DEFINE SET_X2_TO_0 020080d2
DEFINE SET_X2_TO_1 220080d2
DEFINE SET_X3_TO_0 030080d2
DEFINE SET_X3_TO_4  830080d2
DEFINE SET_X8_TO_SYS_BRK c81a80d2
DEFINE SET_X8_TO_SYS_CLONE 881b80d2
DEFINE SET_X8_TO_SYS_EXECVE a81b80d2
DEFINE SET_X8_TO_SYS_EXIT a80b80d2
DEFINE SET_X8_TO_SYS_OPENAT 080780d2
DEFINE SET_X8_TO_SYS_READ e80780d2
DEFINE SET_X8_TO_SYS_WAITID e80b80d2
DEFINE SET_X8_TO_SYS_WRITE 080880d2
DEFINE SET_X9_FROM_X21           e90315aa

DEFINE STRB_W0_[X25]_POST_1      20170038
DEFINE STRB_W9_[X1]              29000039

DEFINE STR_X24_[X23]_POST_8      f88600f8
DEFINE STR_XZR_[SP,24]           ff0f00f9

DEFINE SUB_SP_SP_144             ff4302d1

DEFINE SYSCALL 010000d4

# Where the ELF Header is going to hit
# Simply jump to _start
# Our main function
:_start
    LDR_X1_[SP,16]              # Get the actual input name
    ADD_X20_SP_32               # Get envp (hopefullY)
    CBNZ_X1_OPEN_SCRIPT         # Have real input
    ADD_X20_SP_24               # Nope, envp is here!
    ADR_X1_DEFAULT_FILE         # Use "kaem.aarch64"

:open_script
    SET_X0_TO_FCNTL_H_AT_FDCWD  # AT_FDCWD, relative to current working directory
    SET_X2_TO_0                 # prepare read_only
    SET_X8_TO_SYS_OPENAT        # the syscall number for openat()
    SYSCALL                     # Now open that damn file
    CMP_X0_TO_0                 # IF NULL We couldn't open the file
    B_LE_EXIT                   # Abort hard
    SET_X19_FROM_X0             # Set input pointer
    SUB_SP_SP_144               # Reserve 128 bytes for siginfo and a separate read byte

    SET_X0_TO_0                 # Get current brk
    SET_X8_TO_SYS_BRK           # the Syscall # for SYS_BRK
    SYSCALL                     # Let the kernel do the work
    SET_X21_FROM_X0             # Set our malloc pointer

:command
    # Where the main work gets done
    SET_X0_TO_2048              # Using 256 char* of space
    ^~malloc FCALL              # get it
    SET_X22_FROM_X0             # set tokens
    SET_X23_FROM_X0             # I = 0
    STR_XZR_[SP,24]             # status = 0

:word
    SET_X0_TO_4096              # Using max_string
    ^~malloc FCALL              # allocate space
    SET_X24_FROM_X0             # token = malloc(max_string);
    SET_X25_FROM_X0             # i = 0; set token[i]

:scan
    ^~fgetc FCALL               # c = fgetc(input);
    CMP_W0_TO_252               # if C == EOF
    B_EQ_DONE
    CMP_W0_TO_10                # IF C == '\n'
    B_EQ_LINE_END
    CMP_W0_TO_32                # IF C == ' '
    CCMP_W0_9_4_NE              # IF C == '\t'
    B_EQ_WORD_END
    CMP_W0_TO_34                # IF C == '\"'
    B_EQ_QUOTED
    CMP_W0_TO_35                # IF C == '#'
    B_EQ_COMMENT
    CMP_W0_TO_92                # IF C == '\\'
    B_EQ_ESCAPED
    STRB_W0_[X25]_POST_1        # token[i] = C
    ^~scan RBRANCH              # Keep going

:quoted
    # It is a RAW STRING
    ^~fgetc FCALL               # C = fgetc(input)
    CMP_W0_TO_252               # if C == EOF
    B_EQ_EXIT                   # Something went horribly wrong
    CMP_W0_TO_34
    B_EQ_WORD_END_FROM_QUOTED   # be done
    STRB_W0_[X25]_POST_1        # target[index] = C
    ^~quoted RBRANCH            # Keep going

:escaped
    # It is an escape char
    ^~fgetc FCALL               # Read the char to drop

:word_end
    CMP_X24_TO_X25              # IF i == 0
    B_EQ_WORD                   # Skip an empty word
    STR_X24_[X23]_POST_8        # tokens[i] = result
    ^~word RBRANCH

:comment
# Just throws away everything it reads
    ^~fgetc FCALL               # C = fgetc(input)
    CMP_W0_TO_252               # IF C == EOF
    B_EQ_EXIT_FROM_COMMENT      # abort hard
    CMP_W0_TO_10                # IF C == '\n'
    B_NE_COMMENT                # otherwise keep looping

:line_end
    CMP_X24_TO_X25
    B_EQ_RUN                    # Nothing to append for an empty final word
    STR_X24_[X23]_POST_8        # tokens[i] = result

:run
    CMP_X22_TO_X23
    B_EQ_COMMAND                # Skip a blank command
    ADR_X1_PREFIX               # using " +> "
    ^~File_Print FCALL          # print it
    SET_X26_FROM_X22            # Walk argv without changing its base

:print_arg
    LDR_X1_[X26]_POST_8         # using tokens[j]
    ^~File_Print FCALL          # print it
    ADR_X1_SPACE                # using ' '
    ^~File_Print FCALL          # print it
    CMP_X26_TO_X23
    B_NE_PRINT_ARG              # Stop at the next unused argv slot
    ADR_X1_NEWLINE              # using '\n'
    ^~File_Print FCALL          # print it
    LDR_X0_[X22]                # program = tokens[0]
    CBZ_X0_EXIT                 # IF NULL == program
    SET_X0_TO_17                # flags = SIGCHILD
    SET_X1_TO_0                 # parent_tid
    SET_X2_TO_0                 # tls
    SET_X3_TO_0                 # child_tid
    SET_X8_TO_SYS_CLONE         # FORKing (SYS_clone)
    SYSCALL                     # int f = clone()
    CMP_X0_TO_0                 # Check fork
    B_LT_EXIT                   # IF f == -1 abort hard
    B_NE_PARENT                 # Only the child calls execve
    LDR_X0_[X22]                # program = tokens[0]
    SET_X1_FROM_X22
    SET_X2_FROM_X20             # third arg = envp
    SET_X8_TO_SYS_EXECVE        # EXECVE
    SYSCALL                     # execve(program, tokens, envp);
    ^~exit FBRANCH              # return error

:parent
    SET_X1_FROM_X0              # id = f
    SET_X0_TO_1                 # id_type = P_PID
    SET_X2_FROM_SP              # infop
    SET_X3_TO_4                 #  options = WEXITED
    SET_X8_TO_SYS_WAITID        # WAITID
    SYSCALL
    LDR_X0_[SP,24]              # Using status
    CBZ_X0_COMMAND              # IF 0 == status
    ADR_X1_HARD                 # Using "Subprocess error\nABORTING HARD\n"
    ^~File_Print FCALL          # Print it

:done
    # program completed Successfully
    SET_X0_TO_0                 # All is well

:exit
    SET_X8_TO_SYS_EXIT          # put the exit syscall number in x8
    SYSCALL


# Malloc isn't actually required if the program being built fits in the initial memory
# However, it doesn't take much to add it.
# Requires X21 to hold the current brk and X0 to have the number of desired bytes
# Returns the old brk in X0
:malloc
    SET_X9_FROM_X21             # Save to return later
    ADD_X0_X0_X21               # Request the number of desired bytes
    SET_X8_TO_SYS_BRK           # the Syscall # for SYS_BRK
    SYSCALL                     # call the Kernel
    SET_X21_FROM_X0             # Update pointer
    SET_X0_FROM_X9              # Return the old break
    RETURN


# fgetc function
# Loads the script fd from X19
# Returns a byte in W0, or 0xFC on EOF
:fgetc
    SET_X0_FROM_X19             # Read from the script
    ADD_X1_SP_128               # Byte buffer beyond siginfo
    SET_X2_TO_1
    SET_W9_TO_252               # Leave 0xFC in the buffer if read returns no byte
    STRB_W9_[X1]
    SET_X8_TO_SYS_READ          # the syscall number for read
    SYSCALL                     # call the Kernel
    LDR_BYTE_W0_[X1]            # Return the byte as an unsigned value
    RETURN


# File_Print function
# Receives CHAR* in X1
# writes every non-null char to stdout
:File_Print
    CBZ_X1_FILE_PRINT_DONE      # Protect against nulls
    SET_X2_TO_1                 # set the size of chars we want
    SET_X8_TO_SYS_WRITE         # the syscall number for write

:File_Print_Loop
    LDR_BYTE_W0_[X1]            # Read byte
    CBZ_W0_FILE_PRINT_DONE      # Check for NULL
    SET_X0_TO_1                 # Write to target file
    SYSCALL                     # call the Kernel
    ADD_X1_X1_1                 # S = S + 1
    ^~File_Print_Loop RBRANCH   # Keep going

:File_Print_Done
    RETURN
:default_file "kaem.aarch64"
:prefix " +> "
:space " "
:newline "
"
:hard "Subprocess error
ABORTING HARD
"

:ELF_end
:ELF_sym
:ELF_str
